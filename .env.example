# Payload / PostgreSQL
DATABASE_URL=
# Netlifyなどのserverless runtimeでSupabase Transaction poolerを使う場合のみ transaction
PAYLOAD_DATABASE_POOL_MODE=
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# Local/CI向け。Netlify Productionはcanonical origin、Preview/BranchはDEPLOY_PRIME_URLを使用する。
PAYLOAD_ALLOWED_ORIGINS=http://localhost:3000

# メディアストレージ（S3 / Terraform対応の次PR向けに予約）
S3_BUCKET=
S3_REGION=ap-northeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Contact form email notification (optional; all five required, otherwise the CMS inbox only)
CONTACT_SES_REGION=
CONTACT_SES_ACCESS_KEY_ID=
CONTACT_SES_SECRET_ACCESS_KEY=
CONTACT_SES_CONFIGURATION_SET=
CONTACT_FROM_EMAIL=
# Set to "off" to stop the receipt email to the visitor (on by default once SES is configured)
CONTACT_AUTOREPLY=

# Contact form attachments (optional; all four required, otherwise the file picker stays hidden)
CONTACT_ATTACH_BUCKET=
CONTACT_ATTACH_REGION=
CONTACT_ATTACH_ACCESS_KEY_ID=
CONTACT_ATTACH_SECRET_ACCESS_KEY=

# メールアダプター（このFoundation PRでは未設定）
EMAIL_FROM=ivmz@ivrm.jp

# Optional: raises the GitHub API rate limit (60/h per IP unauthenticated) for the repo facts on Works.
# A fine-grained token with NO permissions (public data only) is enough.
GITHUB_API_TOKEN=

# Optional social / calendar integrations (all server-side, all public data, none needed to run the site)
# Latest uploads from a public YouTube channel feed (ID starts with UC, 24 chars; YouTube Studio -> Settings -> Channel -> Advanced)
YOUTUBE_CHANNEL_ID=
# Public Google Calendar id (Calendar settings -> Integrate calendar; sharing must be "Make available to public")
GOOGLE_CALENDAR_ID=
# Post URLs to show as click-to-load embeds on /links (X, Instagram, TikTok, YouTube), comma or whitespace separated
SOCIAL_EMBED_URLS=

# Optional bot check on the contact form (Cloudflare Turnstile, free). Both are needed to enable it.
# Both are read at request time (Functions/Runtime scope); the secret key must stay server-side only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# Operations monitoring (see docs/ops-monitoring.md). All optional; nothing runs until they are set.
# Shared secret (24+ chars, e.g. `openssl rand -hex 32`) that protects /api/ops/health and /api/ops/retention.
OPS_HEALTH_TOKEN=
# Discord or Slack incoming-webhook URL for failure alerts (contains no personal data).
OPS_ALERT_WEBHOOK_URL=
# Contact submissions are kept this many days after their last update (30-1825, default 365).
CONTACT_RETENTION_DAYS=
# Set to true to allow the scheduled purge to actually delete (otherwise it only reports).
RETENTION_PURGE_ENABLED=

# --- FAQ chat AI answer (optional; the chat works without it, using built-in FAQ answers) ---
# Cloudflare Workers AI free plan (10,000 neurons/day). Create an API token with the
# "Workers AI" permission and copy your Account ID. Both are secrets for Functions/Runtime.
CHAT_LLM_ACCOUNT_ID=
CHAT_LLM_API_TOKEN=
# Optional: model id (default @cf/google/gemma-3-12b-it) and a kill switch (CHAT_LLM=off).
CHAT_LLM_MODEL=
CHAT_LLM=
