    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.2",
    "jsdom": "28.0.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
